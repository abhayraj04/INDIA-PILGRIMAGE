# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/visit?retryWrites=true&w=majority

# Session Secret Key
SESSION_SECRET=your_super_secret_session_key

# Optional: Google Gemini API Key for Live AI Spiritual Guide
# (If not provided, the built-in Spiritual Intelligence Engine will answer automatically!)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (Alternative AI provider)
OPENAI_API_KEY=your_openai_api_key_here

# Optional Port (defaults to 8080 locally)
PORT=8080
