<script>
  const mobileNavToggle = document.getElementById("mobileNavToggle");
  const sacredNav = document.getElementById("sacredNav");
  const helplineModal = document.getElementById("helplineModal");

  if (mobileNavToggle) {
    mobileNavToggle.addEventListener("click", () => {
      sacredNav.classList.toggle("show");
    });
  }

  function openHelplineModal() {
    helplineModal.style.display = "flex";
  }

  function closeHelplineModal() {
    helplineModal.style.display = "none";
  }

  window.addEventListener("click", (e) => {
    if (e.target === helplineModal) {
      closeHelplineModal();
    }
  });
</script>
