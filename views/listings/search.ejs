<% layout("layouts/boilerplate.ejs") %>

<div class="container mt-4" style="margin-top: 60px !important;">
  <h2>Search results for "<%= query %>"</h2>

  <% if (results && results.length > 0) { %>
    <div class="row">
      <% results.forEach(listing => { %>
        <div class="col-md-4 mb-4">
            <div class="card show-card" style="margin: 0 auto; width: 100%; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                 <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_image" style="height: 200px; object-fit: cover;">
                 <div class="card-body">
                   <p class="card-text">
                     <b><h3><%= listing.title %></h3></b>
                     <% if (listing.faith) { %>
                       <span class="badge bg-warning text-dark mb-2" style="font-size: 0.78rem;"><%= listing.faithIcon || '🕊️' %> <%= listing.faith %></span><br>
                     <% } %>
                     <b><h5>Description : </h5></b> <%= listing.description %> <br><br>
                     <b><h5>visiting Time : </h5></b> <%= listing.visitingTime %> <br><br>
                     <a href="/listings/<%= listing._id %>" class="btn btn-primary">View</a>
                     <a href="/ai-guide?destination=<%= encodeURIComponent(listing.title) %>" class="btn btn-warning ms-1" style="font-weight: 600; color: #4a2c2a;">Plan with AI</a>
                    </p>
                </div>
            </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <p>No results found for "<%= query %>"</p>
  <% } %>
</div>
