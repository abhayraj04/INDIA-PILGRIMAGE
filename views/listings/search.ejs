<% layout("layouts/boilerplate.ejs") %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  .search-results-page {
    max-width: 1240px;
    margin: 50px auto 80px auto;
    padding: 0 15px;
    padding-top: 45px;
  }

  .search-header-box {
    margin-bottom: 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    border-bottom: 2px solid #fde68a;
    padding-bottom: 16px;
  }

  .search-header-box h2 {
    color: #78350f;
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0;
  }

  .search-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 25px;
  }

  .search-card {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .search-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(217, 119, 6, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
  }

  .search-thumb-box {
    position: relative;
    width: 100%;
    height: 190px;
    overflow: hidden;
    background: #0f172a;
  }

  .search-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .search-card:hover .search-thumb-img {
    transform: scale(1.08);
  }

  .search-body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .search-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #78350f;
    margin-bottom: 8px;
  }

  .search-desc {
    color: #64748b;
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .search-actions {
    display: flex;
    gap: 8px;
    margin-top: auto;
  }

  .btn-search-view {
    flex: 1;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #1e293b;
    text-decoration: none;
    text-align: center;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .btn-search-view:hover { background: #0284c7; color: #fff; }

  .btn-search-ai {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .btn-search-ai:hover {
    background: linear-gradient(135deg, #d97706, #b45309);
    color: #fff;
  }
</style>

<div class="container search-results-page">

  <div class="search-header-box">
    <h2>
      <i class="bi bi-search text-warning"></i> Search Results for "<%= query %>"
    </h2>
    <a href="/listings" class="btn btn-outline-secondary" style="border-radius: 20px; font-size: 0.88rem;">
      <i class="bi bi-arrow-left"></i> View All Sacred Places
    </a>
  </div>

  <% if (results && results.length > 0) { %>
    <div class="search-grid">
      <% results.forEach(listing => { %>
        <div class="search-card">
          <div class="search-thumb-box">
            <img
              src="<%= listing.image || 'https://images.unsplash.com/photo-1548013146-72479768bada?q=80&w=1000' %>"
              alt="<%= listing.title %>"
              class="search-thumb-img"
              onerror="this.src='https://images.unsplash.com/photo-1548013146-72479768bada?q=80&w=1000'"
            />
          </div>

          <div class="search-body">
            <h3 class="search-title"><%= listing.title %></h3>
            <p class="search-desc"><%= listing.description || 'Sacred pilgrimage site in India.' %></p>

            <div class="search-actions">
              <a href="/listings/<%= listing._id %>" class="btn-search-view">
                <i class="bi bi-eye"></i> Details
              </a>
              <a href="/ai-guide?destination=<%= encodeURIComponent(listing.title) %>" class="btn-search-ai" title="Plan with AI">
                <i class="bi bi-stars"></i> Plan AI
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 70px 20px; background: #fff; border-radius: 20px; border: 1px solid #e2e8f0;">
      <span style="font-size: 3.5rem;">🔍</span>
      <h3 style="margin-top: 15px; color: #475569;">No sacred places found for "<%= query %>"</h3>
      <p style="color: #64748b; margin-bottom: 25px;">
        You can ask Divya Yatra AI to tell you about this place or explore all destinations.
      </p>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/ai-guide?prompt=<%= encodeURIComponent('Tell me about the pilgrimage site ' + query + ' in India, its significance and travel details') %>" class="btn btn-warning" style="border-radius: 30px; font-weight: 700;">
          ✨ Ask Divya Yatra AI
        </a>
        <a href="/listings" class="btn btn-outline-secondary" style="border-radius: 30px;">
          View All Places
        </a>
      </div>
    </div>
  <% } %>

</div>
