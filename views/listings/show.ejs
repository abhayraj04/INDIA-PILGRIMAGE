<style>
  a{
    text-decoration: none;
    color: white;
  }
</style>

<% layout("layouts/boilerplate.ejs") %>
<body>
    <div class="row mt-3 showls">
      <div class="col-8 offset-3">
      </div>
     <div class="card col-6 offset-3 show-card">
      <h3>Place Details : </h3>
       <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_image">
       <div class="card-body">
           <p class="card-text">
              <b> <h3><%= listing.title %></h3></b><br>
              <b><h5>Description : </h5></b> <%= listing.description %> <br><br>
              <b><h5>Near Attractions : </h5></b> <%= listing.nearbyAttractions %> <br><br>
              <b><h5>visiting Time : </h5></b> <%= listing.visitingTime %> <br><br>
              <b><h5>Near Railway Station : </h5></b> <%= listing.railwayStation %> <br><br>
              <button class="btn btn-danger"><a href="<%= listing.location %>">Get Direction</a> </button><br><br>

              <div class="btns">
                <a href="#" class="btn btn-primary col-2 offset-3">About this place</a>
                <form action="#">
                  <button class="btn btn-success offset-5">Book for Guide</button>
                </form>
              </div> 
           </p>
        </div>
      </div>
     <br>
   </div>
   <footer>
  <p>&copy; 2025 India Pilgrimage Guide</p>
</footer>  
</body>
