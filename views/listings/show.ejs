<% layout("layouts/boilerplate.ejs") %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  .show-page-container {
    max-width: 1140px;
    margin: 40px auto 80px auto;
    padding: 0 15px;
    padding-top: 50px;
  }

  /* Hero Section */
  .place-show-hero {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    margin-bottom: 30px;
  }

  .show-image-container {
    position: relative;
    width: 100%;
    height: 420px;
    background: #0f172a;
    cursor: pointer;
    overflow: hidden;
  }

  .show-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .show-image-container:hover img {
    transform: scale(1.03);
  }

  .image-zoom-hint {
    position: absolute;
    bottom: 16px;
    right: 16px;
    background: rgba(15, 23, 42, 0.75);
    color: #fff;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.82rem;
    backdrop-filter: blur(5px);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* Main Grid */
  .show-content-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 30px;
    margin-top: 25px;
  }

  /* Details Left Column */
  .details-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    padding: 30px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  }

  .details-card h1 {
    font-size: 2.1rem;
    font-weight: 800;
    color: #78350f;
    margin-bottom: 14px;
  }

  .details-desc {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #334155;
    margin-bottom: 25px;
  }

  .info-pills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 15px;
    margin-bottom: 30px;
  }

  .info-pill {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 14px 16px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .info-pill-icon {
    font-size: 1.35rem;
    color: #d97706;
    flex-shrink: 0;
  }

  .info-pill-body small {
    display: block;
    color: #64748b;
    font-size: 0.76rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.5px;
  }

  .info-pill-body span {
    color: #1e293b;
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* Action Buttons */
  .show-buttons-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid #f1f5f9;
  }

  .btn-map-dir {
    background: #dc2626;
    color: #fff;
    padding: 11px 22px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
  }
  .btn-map-dir:hover { background: #b91c1c; color: #fff; }

  .btn-ai-show {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #fff;
    padding: 11px 22px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 4px 14px rgba(217, 119, 6, 0.3);
    transition: all 0.2s;
  }
  .btn-ai-show:hover {
    background: linear-gradient(135deg, #d97706, #b45309);
    color: #fff;
    transform: translateY(-2px);
  }

  .btn-budget-show {
    background: #0284c7;
    color: #fff;
    padding: 11px 22px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
  }
  .btn-budget-show:hover { background: #0369a1; color: #fff; }

  /* Right Side Sidebar */
  .sidebar-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .side-card {
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    padding: 22px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.03);
  }

  .side-card h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #78350f;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 0.88rem;
    color: #475569;
    margin-bottom: 10px;
    line-height: 1.5;
  }

  .checklist-item i {
    color: #16a34a;
    font-size: 1rem;
    margin-top: 2px;
  }

  /* Lightbox */
  .lightbox-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    z-index: 20000;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .lightbox-card {
    position: relative;
    max-width: 900px;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }

  .lightbox-card img {
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    background: #000;
  }

  .lightbox-close {
    position: absolute;
    top: 15px;
    right: 20px;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    text-shadow: 0 2px 8px rgba(0,0,0,0.8);
    background: none;
    border: none;
  }

  @media (max-width: 900px) {
    .show-content-grid { grid-template-columns: 1fr; }
    .show-image-container { height: 280px; }
  }
</style>

<div class="container show-page-container">

  <!-- Breadcrumb -->
  <div style="margin-bottom: 16px;">
    <a href="/listings" style="color: #d97706; text-decoration: none; font-weight: 600; font-size: 0.9rem;">
      <i class="bi bi-arrow-left"></i> Back to Sacred Places
    </a>
  </div>

  <!-- Hero Image -->
  <div class="place-show-hero">
    <div class="show-image-container" id="openImageModal">
      <img
        src="<%= listing.image || 'https://images.unsplash.com/photo-1548013146-72479768bada?q=80&w=1000' %>"
        alt="<%= listing.title %>"
        onerror="this.src='https://images.unsplash.com/photo-1548013146-72479768bada?q=80&w=1000'"
      />
      <div class="image-zoom-hint">
        <i class="bi bi-arrows-fullscreen"></i> Tap to view high-resolution image
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="show-content-grid">

    <!-- Left Column: Details -->
    <div class="details-card">
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap;">
        <span class="faith-badge faith-<%= (listing.faith || '').toLowerCase().replace(/[^a-z]/g, '') %>" style="font-size: 0.85rem; padding: 5px 14px; font-weight: 700; border-radius: 20px; display: inline-flex; align-items: center; gap: 6px;">
          <%= listing.faithIcon || '🕊️' %> <%= listing.faith || 'Sacred Site' %>
        </span>
        <span style="color: #64748b; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 5px;">
          <i class="bi bi-shield-check text-success"></i> India Pilgrimage Verified
        </span>
      </div>
      <h1><%= listing.title %></h1>
      <p class="details-desc"><%= listing.description %></p>

      <!-- Key Details Pills -->
      <div class="info-pills-grid">
        <div class="info-pill">
          <i class="bi bi-clock-history info-pill-icon"></i>
          <div class="info-pill-body">
            <small>Visiting Hours</small>
            <span><%= listing.visitingTime || 'Open for devotees (General darshan hours)' %></span>
          </div>
        </div>

        <div class="info-pill">
          <i class="bi bi-train-front info-pill-icon"></i>
          <div class="info-pill-body">
            <small>Nearest Railway Station</small>
            <span><%= listing.railwayStation || 'Check nearby rail junction' %></span>
          </div>
        </div>

        <div class="info-pill">
          <i class="bi bi-compass info-pill-icon"></i>
          <div class="info-pill-body">
            <small>Nearby Attractions</small>
            <span><%= listing.nearbyAttractions || 'Sacred ghats, ashrams & historic shrines' %></span>
          </div>
        </div>

        <div class="info-pill">
          <i class="bi bi-geo-alt info-pill-icon"></i>
          <div class="info-pill-body">
            <small>Estimated Distance</small>
            <span>~<%= listing.distance || 500 %> km</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="show-buttons-row">
        <% if (listing.location) { %>
          <a href="<%= listing.location %>" target="_blank" rel="noopener noreferrer" class="btn-map-dir">
            <i class="bi bi-geo-alt-fill"></i> Get Directions
          </a>
        <% } %>

        <a href="/ai-guide?destination=<%= encodeURIComponent(listing.title) %>" class="btn-ai-show">
          <i class="bi bi-stars"></i> Plan Itinerary with AI
        </a>

        <a href="/budget?place=<%= encodeURIComponent(listing.title) %>" class="btn-budget-show">
          <i class="bi bi-calculator"></i> Calculate Budget
        </a>

        <button class="btn btn-outline-secondary" style="border-radius: 30px; padding: 11px 18px;" onclick="sharePlace()">
          <i class="bi bi-share-fill"></i> Share
        </button>
      </div>
    </div>

    <!-- Right Column: Pilgrim Advice Sidebar -->
    <div class="sidebar-column">
      <!-- Sacred AI Helper card -->
      <div class="side-card" style="background: linear-gradient(135deg, #fffbeb, #fef3c7); border-color: #fde68a;">
        <h4><i class="bi bi-stars text-warning"></i> Divya Yatra AI</h4>
        <p style="font-size: 0.88rem; color: #78350f; line-height: 1.6; margin-bottom: 12px;">
          Have questions about the dress code, VIP passes, or senior citizen assistance for <b><%= listing.title %></b>?
        </p>
        <a href="/ai-guide?prompt=<%= encodeURIComponent('What are the darshan rules, dress code, and senior citizen assistance at ' + listing.title + '?') %>" class="btn btn-warning w-100" style="border-radius: 12px; font-weight: 700; color: #78350f;">
          Ask AI About <%= listing.title %>
        </a>
      </div>

      <!-- Pilgrim Checklist Card -->
      <div class="side-card">
        <h4><i class="bi bi-check2-circle text-success"></i> Pilgrim Guidelines</h4>
        <div class="checklist-item">
          <i class="bi bi-check-circle-fill"></i>
          <span><b>Modest Attire:</b> Wear traditional, respectful clothing covering shoulders and knees.</span>
        </div>
        <div class="checklist-item">
          <i class="bi bi-check-circle-fill"></i>
          <span><b>Footwear:</b> Deposit shoes at the designated shrine shoe-stands (Joda Ghar) prior to entering.</span>
        </div>
        <div class="checklist-item">
          <i class="bi bi-check-circle-fill"></i>
          <span><b>Photography:</b> Verify photography restrictions before filming inside sanctum sanctorums.</span>
        </div>
        <div class="checklist-item">
          <i class="bi bi-check-circle-fill"></i>
          <span><b>Identity:</b> Carry government photo ID (Aadhaar / Voter ID / Passport) for shrine board verification.</span>
        </div>
        <a href="/etiquette" class="btn btn-outline-success btn-sm w-100 mt-2" style="border-radius: 10px; font-weight: 600;">
          <i class="bi bi-journal-text me-1"></i> Universal Sacred Etiquette Guide
        </a>
      </div>
    </div>

  </div>

</div>

<!-- Lightbox Modal -->
<div id="imageLightboxModal" class="lightbox-overlay">
  <button class="lightbox-close" id="closeImageModal">&times;</button>
  <div class="lightbox-card">
    <img src="<%= listing.image %>" alt="<%= listing.title %>">
  </div>
</div>

<script>
  const openModal = document.getElementById("openImageModal");
  const modal = document.getElementById("imageLightboxModal");
  const closeModal = document.getElementById("closeImageModal");

  if (openModal) {
    openModal.addEventListener("click", () => {
      modal.style.display = "flex";
    });
  }

  if (closeModal) {
    closeModal.addEventListener("click", () => {
      modal.style.display = "none";
    });
  }

  window.addEventListener("click", (e) => {
    if (e.target === modal) {
      modal.style.display = "none";
    }
  });

  function sharePlace() {
    if (navigator.share) {
      navigator.share({
        title: "<%= listing.title %> - India Pilgrimage",
        text: "Explore <%= listing.title %> on India Pilgrimage Guide!",
        url: window.location.href
      });
    } else {
      navigator.clipboard.writeText(window.location.href).then(() => {
        alert("✅ Link copied to clipboard!");
      });
    }
  }
</script>
