<% layout("layouts/boilerplate.ejs") %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  .listings-page-container {
    max-width: 1260px;
    margin: 40px auto 70px auto;
    padding: 0 15px;
    padding-top: 60px;
  }

  .listings-header {
    text-align: center;
    margin-bottom: 35px;
  }

  .listings-header h1 {
    font-size: 2.3rem;
    font-weight: 800;
    color: #78350f;
    margin-bottom: 10px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .listings-header p {
    color: #57534e;
    font-size: 1.05rem;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Search & Filter Toolbar */
  .toolbar-card {
    background: #ffffff;
    border: 1px solid rgba(217, 119, 6, 0.25);
    border-radius: 20px;
    padding: 22px 24px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    margin-bottom: 35px;
  }

  .search-input-box {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: 18px;
  }

  .search-input-box input {
    width: 100%;
    border: 1.5px solid #cbd5e1;
    border-radius: 30px;
    padding: 12px 50px 12px 46px;
    font-size: 1rem;
    outline: none;
    transition: all 0.2s;
  }

  .search-input-box input:focus {
    border-color: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
  }

  .search-icon-inside {
    position: absolute;
    left: 18px;
    color: #94a3b8;
    font-size: 1.1rem;
  }

  .mic-btn {
    position: absolute;
    right: 14px;
    background: none;
    border: none;
    color: #d97706;
    font-size: 1.25rem;
    cursor: pointer;
    transition: all 0.2s;
    padding: 4px;
  }
  .mic-btn:hover { transform: scale(1.15); color: #b45309; }
  .mic-btn.listening { color: #dc2626; animation: pulseMic 1s infinite; }

  @keyframes pulseMic {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.25); }
  }

  /* Filter Section */
  .filter-section-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 700;
    color: #64748b;
    margin-bottom: 8px;
  }

  .filter-chips-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 14px;
  }

  .filter-chip-btn {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 0.84rem;
    color: #475569;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .filter-chip-btn:hover {
    background: #fffbeb;
    border-color: #f59e0b;
    color: #b45309;
  }

  .filter-chip-btn.active {
    background: #f59e0b;
    border-color: #d97706;
    color: #ffffff;
    box-shadow: 0 3px 10px rgba(217, 119, 6, 0.3);
  }

  .results-count-badge {
    font-size: 0.85rem;
    color: #64748b;
    font-weight: 600;
  }

  /* Cards Grid */
  .places-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 25px;
  }

  .place-card-wrap {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .place-card-wrap:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(217, 119, 6, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
  }

  .place-thumb-box {
    position: relative;
    width: 100%;
    height: 195px;
    overflow: hidden;
    background: #1e293b;
  }

  .place-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .place-card-wrap:hover .place-thumb-img {
    transform: scale(1.08);
  }

  .place-distance-tag {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(15, 23, 42, 0.8);
    color: #fbbf24;
    font-size: 0.74rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(251, 191, 36, 0.4);
  }

  .place-body {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .faith-tag-row {
    margin-bottom: 8px;
  }

  .place-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #78350f;
    margin-bottom: 8px;
    line-height: 1.4;
  }

  .place-desc {
    color: #64748b;
    font-size: 0.88rem;
    line-height: 1.5;
    margin-bottom: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .place-meta {
    font-size: 0.8rem;
    color: #475569;
    margin-bottom: 15px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .place-meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .place-card-actions {
    display: flex;
    gap: 8px;
    margin-top: auto;
  }

  .btn-explore {
    flex: 1;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    color: #1e293b;
    text-decoration: none;
    text-align: center;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s;
  }

  .btn-explore:hover {
    background: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
  }

  .btn-plan-ai {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #ffffff;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all 0.2s;
  }

  .btn-plan-ai:hover {
    background: linear-gradient(135deg, #d97706, #b45309);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .empty-state {
    display: none;
    text-align: center;
    padding: 60px 20px;
    color: #64748b;
  }

  @media (max-width: 768px) {
    .listings-header h1 { font-size: 1.8rem; }
    .toolbar-card { padding: 16px; }
  }
</style>

<div class="container listings-page-container">

  <!-- Header -->
  <div class="listings-header">
    <div style="font-size: 2rem; margin-bottom: 8px;">🛕 • ☬ • ☪️ • ☸️ • 🌸 • ✝️</div>
    <h1>Sacred Pilgrimage Places of India</h1>
    <p>Explore revered pilgrimage sites across all spiritual traditions of Bharat: Temples, Gurdwaras, Dargahs, Monasteries, Jain Tirthas, and Historic Basilicas.</p>
  </div>

  <!-- Search & Multi-Faith Filter Toolbar -->
  <div class="toolbar-card">
    <!-- Live Search with Voice Mic -->
    <div class="search-input-box">
      <i class="bi bi-search search-icon-inside"></i>
      <input
        type="text"
        id="liveSearchInput"
        placeholder="Search any place, deity, or tradition (e.g. Varanasi, Golden Temple, Ajmer, Bodh Gaya, Velankanni)..."
        autocomplete="off"
      />
      <button type="button" class="mic-btn" id="voiceSearchBtn" title="Search by Voice (Hindi / English)">
        <i class="bi bi-mic-fill"></i>
      </button>
    </div>

    <!-- Faith Filters -->
    <div>
      <div class="filter-section-title">Filter by Spiritual Tradition:</div>
      <div class="filter-chips-row">
        <button class="filter-chip-btn active" onclick="filterByFaith('all', this)">🕊️ All Traditions</button>
        <button class="filter-chip-btn" onclick="filterByFaith('Hinduism', this)">🛕 Hinduism</button>
        <button class="filter-chip-btn" onclick="filterByFaith('Sikhism', this)">☬ Sikhism</button>
        <button class="filter-chip-btn" onclick="filterByFaith('Islam & Sufism', this)">☪️ Islam & Sufism</button>
        <button class="filter-chip-btn" onclick="filterByFaith('Buddhism', this)">☸️ Buddhism</button>
        <button class="filter-chip-btn" onclick="filterByFaith('Jainism', this)">🌸 Jainism</button>
        <button class="filter-chip-btn" onclick="filterByFaith('Christianity', this)">✝️ Christianity</button>
      </div>
    </div>

    <!-- Region Filters & Counter -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; border-top: 1px solid #f1f5f9; padding-top: 12px;">
      <div class="filter-chips-row" style="margin-bottom: 0;">
        <span style="font-size: 0.8rem; font-weight: 700; color: #64748b; margin-right: 4px;">Region:</span>
        <button class="filter-chip-btn" onclick="filterByKeyword('North', this)">North India</button>
        <button class="filter-chip-btn" onclick="filterByKeyword('South', this)">South India</button>
        <button class="filter-chip-btn" onclick="filterByKeyword('East', this)">East India</button>
        <button class="filter-chip-btn" onclick="filterByKeyword('West', this)">West India</button>
        <button class="filter-chip-btn" onclick="filterByKeyword('Central', this)">Central India</button>
      </div>

      <span class="results-count-badge" id="resultsCount">
        Showing <%= allListings.length %> destinations
      </span>
    </div>
  </div>

  <!-- Places Grid -->
  <div class="places-grid" id="placesGrid">
    <% for(let listing of allListings){ %>
      <% 
        const faithName = listing.faith || 'Hinduism';
        const faithSlug = faithName.toLowerCase().replace(/[^a-z]/g, '');
      %>
      <div
        class="place-card-wrap"
        data-faith="<%= faithName %>"
        data-title="<%= (listing.title || '').toLowerCase() %>"
        data-desc="<%= (listing.description || '').toLowerCase() %>"
        data-near="<%= (listing.nearbyAttractions || '').toLowerCase() %>"
        data-station="<%= (listing.railwayStation || '').toLowerCase() %>"
      >
        <div class="place-thumb-box">
          <img
            src="<%= listing.image || 'https://images.unsplash.com/photo-1548013146-72479768bada?q=80&w=1000' %>"
            alt="<%= listing.title %>"
            class="place-thumb-img"
            loading="lazy"
            onerror="this.src='https://images.unsplash.com/photo-1548013146-72479768bada?q=80&w=1000'"
          />
          <% if (listing.distance) { %>
            <div class="place-distance-tag">
              <i class="bi bi-geo-fill"></i> ~<%= listing.distance %> km
            </div>
          <% } %>
        </div>

        <div class="place-body">
          <div class="faith-tag-row">
            <span class="faith-badge faith-<%= faithSlug %>">
              <%= listing.faithIcon || '🕊️' %> <%= faithName %>
            </span>
          </div>

          <h3 class="place-title"><%= listing.title %></h3>
          <p class="place-desc"><%= listing.description || 'Sacred pilgrimage sanctuary in India.' %></p>

          <div class="place-meta">
            <% if (listing.railwayStation) { %>
              <div class="place-meta-item" title="<%= listing.railwayStation %>">
                <i class="bi bi-train-front text-warning"></i> <%= listing.railwayStation %>
              </div>
            <% } %>
            <% if (listing.visitingTime) { %>
              <div class="place-meta-item" title="<%= listing.visitingTime %>">
                <i class="bi bi-clock-history text-warning"></i> <%= listing.visitingTime %>
              </div>
            <% } %>
          </div>

          <div class="place-card-actions">
            <a href="/listings/<%= listing._id %>" class="btn-explore">
              <i class="bi bi-eye"></i> Details
            </a>
            <a href="/ai-guide?destination=<%= encodeURIComponent(listing.title) %>" class="btn-plan-ai" title="Plan Itinerary with AI">
              <i class="bi bi-stars"></i> Plan AI
            </a>
          </div>
        </div>
      </div>
    <% } %>
  </div>

  <!-- Empty Search State -->
  <div id="emptySearchState" class="empty-state">
    <span style="font-size: 3rem;">🔍</span>
    <h4 style="margin-top: 15px; color: #475569;">No sacred places found matching your filter.</h4>
    <p>Try searching with another keyword or explore All Traditions.</p>
    <button class="btn btn-warning" onclick="resetAllFilters()">Reset All Filters</button>
  </div>

</div>

<script>
  let activeFaithFilter = "all";
  let activeKeywordFilter = "";

  const liveSearch = document.getElementById("liveSearchInput");
  const placesGrid = document.getElementById("placesGrid");
  const cards = Array.from(document.querySelectorAll(".place-card-wrap"));
  const countBadge = document.getElementById("resultsCount");
  const emptyState = document.getElementById("emptySearchState");
  const voiceSearchBtn = document.getElementById("voiceSearchBtn");

  function filterCards() {
    const q = liveSearch.value.toLowerCase().trim();
    let visibleCount = 0;

    cards.forEach(card => {
      const cardFaith = card.getAttribute("data-faith") || "";
      const title = card.getAttribute("data-title") || "";
      const desc = card.getAttribute("data-desc") || "";
      const near = card.getAttribute("data-near") || "";
      const station = card.getAttribute("data-station") || "";

      // Match faith
      const matchFaith = (activeFaithFilter === "all" || cardFaith === activeFaithFilter);

      // Match text query
      const matchText = !q || title.includes(q) || desc.includes(q) || near.includes(q) || station.includes(q) || cardFaith.toLowerCase().includes(q);

      if (matchFaith && matchText) {
        card.style.display = "flex";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });

    countBadge.innerText = `Showing ${visibleCount} destinations`;
    if (visibleCount === 0) {
      emptyState.style.display = "block";
    } else {
      emptyState.style.display = "none";
    }
  }

  liveSearch.addEventListener("input", filterCards);

  function filterByFaith(faith, btn) {
    activeFaithFilter = faith;
    const parentRow = btn.parentElement;
    parentRow.querySelectorAll(".filter-chip-btn").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    filterCards();
  }

  function filterByKeyword(keyword, btn) {
    liveSearch.value = keyword;
    filterCards();
  }

  function resetAllFilters() {
    activeFaithFilter = "all";
    liveSearch.value = "";
    document.querySelectorAll(".filter-chip-btn").forEach(b => b.classList.remove("active"));
    const firstChip = document.querySelector(".filter-chip-btn");
    if (firstChip) firstChip.classList.add("active");
    filterCards();
  }

  // Voice Search with Web Speech Recognition
  if (voiceSearchBtn && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const recognition = new SpeechRecognition();
    recognition.lang = 'en-IN'; // Supports Indian English and Hindi accent
    recognition.continuous = false;
    recognition.interimResults = false;

    voiceSearchBtn.addEventListener("click", () => {
      voiceSearchBtn.classList.add("listening");
      recognition.start();
    });

    recognition.onresult = (event) => {
      const transcript = event.results[0][0].transcript;
      liveSearch.value = transcript;
      filterCards();
      voiceSearchBtn.classList.remove("listening");
    };

    recognition.onerror = () => {
      voiceSearchBtn.classList.remove("listening");
    };

    recognition.onend = () => {
      voiceSearchBtn.classList.remove("listening");
    };
  } else if (voiceSearchBtn) {
    voiceSearchBtn.style.display = "none";
  }
</script>
