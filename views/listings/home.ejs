function debounce(fn, wait){ let t; return (...args)=>{ clearTimeout(t); t = setTimeout(()=>fn(...args), wait); }; }

  (function(){
    const input = document.getElementById('search-input');
    const list  = document.getElementById('suggestions');

    if (!input || !list) return;

    function clearList(){ list.innerHTML = ''; list.style.display = 'none'; }

    function render(items){
      if (!items || items.length === 0){ clearList(); return; }
      list.innerHTML = items.map(i => `<li class="suggest-item" role="option">${i}</li>`).join('');
      list.style.display = 'block';
    }

    const fetchSuggestions = debounce(async function(){
      const v = input.value.trim();
      if (!v) { clearList(); return; }
      try {
        const res = await fetch('/suggest?q=' + encodeURIComponent(v));
        if (!res.ok) { clearList(); return; }
        const data = await res.json();
        render(data);
      } catch (e) { clearList(); }
    }, 200);

    input.addEventListener('input', fetchSuggestions);

     list.addEventListener('click', function(e){
      const it = e.target.closest('.suggest-item');
      if (!it) return;
      input.value = it.textContent;
      clearList();
     });

     document.addEventListener('click', (e)=>{ if (!e.target.closest('#search-input') && !e.target.closest('#suggestions')) clearList(); });
    document.addEventListener('keydown', (e)=>{ if (e.key === 'Escape') clearList(); });

  })();

