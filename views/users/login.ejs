<% layout("layouts/boilerplate.ejs") %>

<div class="row mt-3 signup">
    <h1 class="col-6 offset-3">Welcome back</h1>
    
    <p class="col-6 offset-3">Login to book guides, manage prasad orders and personalize your</p>
    <div class="col-6 offset-3">
        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mt-3">
                <label for="username" class="form-label">Username</label>
                <input name="username" type="text" class="form-control" id="username" required>
                <div class="valid-feedback">Look good</div>
            </div>
            <div class="mt-3">
                <label for="password" class="form-label">Password</label>
                <input name="password" type="password" class="form-control" id="password" required>
            </div>
            <button class="btn btn-success">Login</button>
            <p>Don't have an account? <a href="/singup">Sign up here</a></p>
        </form>
        <hr>
        <h2>Appoint a guide</h2>
        <p>After login, you can appoint a local guide for any temple or region.</p>
         <a href="/login"><button class="btn btn-outline-info"">Explore guide services</button></a>
    </div>
</div>
<footer>
  <p>&copy; 2025 India Pilgrimage Guide</p>
</footer>