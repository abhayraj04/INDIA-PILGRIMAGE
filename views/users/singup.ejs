<% layout("layouts/boilerplate.ejs") %>

<div class="row mt-3 signup">
    <h1 class="col-6 offset-3">Sign up on India Pilgrimage</h1>
    <div class="col-6 offset-3">
        <!-- <form action="/singup" method="POST" class="needs-validation" novalidate> -->
            <form action="/singup" method="POST" class="needs-validation">

            <div class="mt-3">
                <label for="username" class="form-label">Username</label>
                <input name="username" type="text" class="form-control" id="username" placeholder="Enter your username" required>
                <div class="valid-feedback">Look good</div>
            </div>
            <div class="mt-3">
                <label for="email" class="form-label">Email</label>
                <input name="email" type="email" class="form-control" id="email" placeholder="abc@gmail.com"  required>
                 
        <small class="error" id="email-error"></small> 
            </div>
            <div class="mt-3">
                <label for="password" class="form-label">Password</label>
                <input name="password" type="password" class="form-control" id="password" required>
            </div>
            <button class="btn btn-success">Submit</button>
            <p>Already have an account? <a href="/login">Login here</a></p>
        </form>
    </div>
</div>
<footer style="position: fixed;">
  <p>&copy; 2025 India Pilgrimage Guide</p>
</footer>