<% layout("layouts/boilerplate.ejs") %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  :root {
    --gold-primary: #d4a373;
    --gold-dark: #b07d4b;
    --saffron-main: #ff8c00;
    --saffron-light: #fff7ed;
    --sacred-dark: #0f172a;
    --sacred-blue: #1e3a8a;
  }

  .ai-guide-page {
    max-width: 1100px;
    margin: 40px auto 80px auto;
    padding: 0 15px;
    padding-top: 50px;
  }

  /* Universal Divine Banner */
  .divine-banner {
    background: linear-gradient(135deg, #0b132b 0%, #1c2541 50%, #3a506b 100%);
    border-radius: 24px;
    padding: 40px 30px;
    color: #ffffff;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 215, 0, 0.35);
  }

  .divine-banner::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 183, 3, 0.18) 0%, transparent 60%);
    pointer-events: none;
    animation: rotateGlow 22s linear infinite;
  }

  @keyframes rotateGlow {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .divine-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 215, 0, 0.15);
    border: 1px solid rgba(255, 215, 0, 0.45);
    color: #ffe066;
    padding: 6px 18px;
    border-radius: 30px;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 16px;
    backdrop-filter: blur(8px);
  }

  .divine-banner h1 {
    font-size: 2.3rem;
    font-weight: 800;
    background: linear-gradient(90deg, #fff3b0, #ffd166, #f39c12);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 12px;
  }

  .divine-banner p {
    color: #cbd5e1;
    font-size: 1.05rem;
    max-width: 740px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Audio Ambience & Controls bar */
  .divine-audio-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 22px;
    flex-wrap: wrap;
  }

  .audio-select {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 215, 0, 0.4);
    color: #fff;
    padding: 7px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    outline: none;
    cursor: pointer;
  }

  .audio-select option {
    background: #1e293b;
    color: #fff;
  }

  .audio-toggle-btn {
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 215, 0, 0.4);
    color: #fffae0;
    padding: 8px 18px;
    border-radius: 30px;
    font-size: 0.88rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s ease;
    backdrop-filter: blur(5px);
  }

  .audio-toggle-btn:hover {
    background: rgba(255, 215, 0, 0.25);
    color: #fff;
    transform: translateY(-2px);
  }

  .audio-toggle-btn.playing {
    background: #f59e0b;
    color: #0f172a;
    font-weight: 700;
    border-color: #f59e0b;
  }

  /* Mode Switcher Tabs */
  .mode-tabs {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin: 30px 0 25px 0;
    flex-wrap: wrap;
  }

  .mode-tab-btn {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    color: #475569;
    padding: 12px 26px;
    border-radius: 30px;
    font-size: 0.96rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    box-shadow: 0 3px 8px rgba(0,0,0,0.04);
  }

  .mode-tab-btn:hover {
    border-color: #f59e0b;
    color: #b45309;
    transform: translateY(-2px);
  }

  .mode-tab-btn.active {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    border-color: #d97706;
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(217, 119, 6, 0.35);
  }

  /* Card Container */
  .planner-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.05);
    overflow: hidden;
    padding: 30px;
  }

  /* Wizard Form */
  .wizard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 25px;
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.9rem;
    color: #1e293b;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .form-control, .form-select {
    border-radius: 14px;
    border: 1.5px solid #cbd5e1;
    padding: 11px 16px;
    font-size: 0.95rem;
    transition: all 0.2s ease;
  }

  .form-control:focus, .form-select:focus {
    border-color: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
  }

  .dest-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .dest-pill {
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 20px;
    padding: 5px 12px;
    font-size: 0.82rem;
    color: #334155;
    cursor: pointer;
    transition: all 0.2s;
  }

  .dest-pill:hover {
    background: #fffbeb;
    border-color: #f59e0b;
    color: #b45309;
  }

  .generate-btn {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #ffffff;
    border: none;
    border-radius: 30px;
    padding: 14px 32px;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 8px 24px rgba(217, 119, 6, 0.35);
    transition: all 0.25s ease;
  }

  .generate-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(217, 119, 6, 0.45);
    background: linear-gradient(135deg, #fbbf24 0%, #b45309 100%);
  }

  .generate-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  /* Output Display */
  .itinerary-output {
    display: none;
    margin-top: 35px;
    padding-top: 30px;
    border-top: 2px dashed #e2e8f0;
    animation: fadeIn 0.4s ease;
  }

  .itinerary-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
    background: #fff8eb;
    border: 1px solid #fde68a;
    padding: 14px 20px;
    border-radius: 16px;
  }

  .itinerary-title-meta h3 {
    font-size: 1.25rem;
    color: #92400e;
    font-weight: 700;
    margin: 0;
  }

  .itinerary-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tool-btn {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    color: #334155;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
  }

  .tool-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
    border-color: #94a3b8;
  }

  .tool-btn.btn-voice.speaking {
    background: #dc2626;
    color: white;
    border-color: #dc2626;
  }

  .itinerary-content {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 28px;
    line-height: 1.7;
    color: #1e293b;
    font-size: 1rem;
    box-shadow: 0 4px 14px rgba(0,0,0,0.03);
  }

  .itinerary-content h3, .itinerary-content h4 {
    color: #92400e;
    margin-top: 14px;
    margin-bottom: 8px;
    font-weight: 700;
  }

  .itinerary-content ul {
    padding-left: 24px;
    margin-bottom: 12px;
  }

  .itinerary-content li {
    margin-bottom: 6px;
  }

  /* Chat Pane */
  .chat-pane {
    display: none;
  }

  .chat-box {
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    overflow: hidden;
  }

  .chat-header {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 14px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .chat-messages {
    height: 480px;
    overflow-y: auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: #fafaf9;
    scroll-behavior: smooth;
  }

  .message {
    display: flex;
    gap: 12px;
    max-width: 88%;
    animation: fadeIn 0.3s ease;
  }

  .message.user-message {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .message.bot-message {
    align-self: flex-start;
  }

  .message-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    flex-shrink: 0;
  }

  .bot-message .message-avatar {
    background: linear-gradient(135deg, #d97706, #f59e0b);
    color: white;
  }

  .user-message .message-avatar {
    background: linear-gradient(135deg, #0284c7, #2563eb);
    color: white;
  }

  .message-bubble {
    padding: 14px 18px;
    border-radius: 16px;
    font-size: 0.95rem;
    line-height: 1.6;
    word-break: break-word;
  }

  .user-message .message-bubble {
    background: #2563eb;
    color: white;
    border-bottom-right-radius: 4px;
  }

  .bot-message .message-bubble {
    background: #ffffff;
    color: #1e293b;
    border: 1px solid #e2e8f0;
    border-bottom-left-radius: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .chat-input-bar {
    padding: 16px 20px;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
  }

  .chat-input-wrapper {
    display: flex;
    gap: 10px;
    align-items: center;
    position: relative;
  }

  .chat-input {
    flex: 1;
    border: 1.5px solid #cbd5e1;
    border-radius: 30px;
    padding: 12px 50px 12px 20px;
    font-size: 0.96rem;
    outline: none;
  }
  .chat-input:focus {
    border-color: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
  }

  .chat-mic-btn {
    position: absolute;
    right: 58px;
    background: none;
    border: none;
    color: #d97706;
    font-size: 1.25rem;
    cursor: pointer;
    padding: 4px;
  }
  .chat-mic-btn:hover { transform: scale(1.15); }
  .chat-mic-btn.listening { color: #dc2626; animation: pulseMic 1s infinite; }

  .send-btn {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: white;
    border: none;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .chip-btn {
    background: #ffffff;
    border: 1px solid rgba(212, 163, 115, 0.35);
    border-radius: 20px;
    padding: 8px 15px;
    font-size: 0.88rem;
    color: #334155;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .chip-btn:hover {
    background: #fff8eb;
    border-color: #f59e0b;
    color: #b45309;
    transform: translateY(-2px);
  }

  @media print {
    body * { visibility: hidden; }
    #itineraryOutput, #itineraryOutput * { visibility: visible; }
    #itineraryOutput { position: absolute; left: 0; top: 0; width: 100%; }
    .itinerary-actions { display: none; }
  }

  @media (max-width: 768px) {
    .divine-banner h1 { font-size: 1.7rem; }
    .planner-card { padding: 18px; }
    .chat-messages { height: 380px; }
  }
</style>

<div class="container ai-guide-page">

  <!-- Header Banner Embracing All Sacred Traditions -->
  <div class="divine-banner">
    <div class="divine-badge-top">
      <span>🕊️</span> Universal Pilgrimage AI Companion • सर्वधर्म समभाव
    </div>
    <h1>Universal Sacred Pilgrimage AI Guide</h1>
    <p>Accurate hour-by-hour sacred itineraries, official temple/shrine protocols, holy dress codes, senior citizen assistance, and peaceful dharamshalas across all spiritual traditions of Bharat.</p>

    <!-- Multi-Faith Ambient Meditation Synthesizer -->
    <div class="divine-audio-bar">
      <select id="audioDroneType" class="audio-select">
        <option value="om">🪔 Vedic & Temple Bells (432 Hz)</option>
        <option value="gurbani">☬ Gurbani Peace Tanpura (Sa-Pa Drone)</option>
        <option value="bowl">☸️ Tibetan Singing Bowl (528 Hz Healing)</option>
      </select>
      <button id="audioAmbienceBtn" class="audio-toggle-btn" onclick="toggleDivineAmbience()">
        <i class="bi bi-music-note-beamed"></i> <span id="audioStatusText">Play Meditative Ambience</span>
      </button>
    </div>
  </div>

  <!-- Mode Selector Tabs -->
  <div class="mode-tabs">
    <button id="tabWizardBtn" class="mode-tab-btn active" onclick="switchMode('wizard')">
      <i class="bi bi-compass-fill"></i> Sacred Itinerary Wizard
    </button>
    <button id="tabChatBtn" class="mode-tab-btn" onclick="switchMode('chat')">
      <i class="bi bi-chat-heart-fill"></i> Ask Divya Yatra AI
    </button>
  </div>

  <!-- Mode 1: Itinerary Wizard -->
  <div id="wizardPane" class="planner-card">
    <div style="margin-bottom: 25px;">
      <h3 style="font-size: 1.35rem; color: #92400e; font-weight: 700; margin-bottom: 6px;">
        🕊️ Design Your Sacred Spiritual Itinerary
      </h3>
      <p style="color: #64748b; font-size: 0.95rem; margin: 0;">
        Choose any holy shrine across all faiths, duration, and preferences for an instant day-by-day pilgrimage timetable.
      </p>
    </div>

    <form id="wizardForm" onsubmit="handleWizardSubmit(event)">
      <div class="wizard-grid">

        <!-- Destination with multi-faith pills -->
        <div class="form-group" style="grid-column: span 2;">
          <label><i class="bi bi-geo-alt-fill text-warning"></i> Sacred Destination or Pilgrimage Circuit:</label>
          <input
            type="text"
            id="wizardDest"
            class="form-control"
            placeholder="e.g. Golden Temple Amritsar, Varanasi Kashi, Ajmer Sharif, Bodh Gaya, Velankanni, Kedarnath..."
            value="<%= initialDestination %>"
            required
          />
          <div class="dest-pills">
            <span class="dest-pill" onclick="pickDest('Golden Temple (Amritsar)')">☬ Golden Temple</span>
            <span class="dest-pill" onclick="pickDest('Varanasi (Kashi Vishwanath & Ganga Ghats)')">🛕 Varanasi (Kashi)</span>
            <span class="dest-pill" onclick="pickDest('Ajmer Sharif Dargah (Khwaja Garib Nawaz)')">☪️ Ajmer Sharif</span>
            <span class="dest-pill" onclick="pickDest('Mahabodhi Temple & Bodh Gaya')">☸️ Bodh Gaya</span>
            <span class="dest-pill" onclick="pickDest('Palitana & Dilwara Jain Temples')">🌸 Palitana & Dilwara</span>
            <span class="dest-pill" onclick="pickDest('Basilica of Bom Jesus (Goa) & Velankanni')">✝️ Basilica of Bom Jesus</span>
            <span class="dest-pill" onclick="pickDest('Kedarnath & Badrinath (Uttarakhand)')">🏔️ Kedarnath Dham</span>
            <span class="dest-pill" onclick="pickDest('Tirupati Balaji (Sri Venkateswara)')">🛕 Tirupati Balaji</span>
          </div>
        </div>

        <!-- Duration -->
        <div class="form-group">
          <label><i class="bi bi-calendar-event-fill text-warning"></i> Total Duration:</label>
          <select id="wizardDays" class="form-select">
            <option value="1">1 Day (Express Darshan / Ziyarat)</option>
            <option value="2">2 Days (Weekend Pilgrimage)</option>
            <option value="3" selected>3 Days (Complete Spiritual Tour)</option>
            <option value="5">5 Days (Deep Yatra & Circuit)</option>
            <option value="7">7 Days (Full Sacred Immersion)</option>
          </select>
        </div>

        <!-- Devotees -->
        <div class="form-group">
          <label><i class="bi bi-people-fill text-warning"></i> Devotees / Travelers:</label>
          <select id="wizardTravelers" class="form-select">
            <option value="1">1 (Solo Spiritual Seeker)</option>
            <option value="2" selected>2 Devotees (Couple / Friends)</option>
            <option value="4">4 Devotees (Family Group)</option>
            <option value="8">8+ Devotees (Large Yatra Sangh)</option>
          </select>
        </div>

        <!-- Stay Style -->
        <div class="form-group">
          <label><i class="bi bi-wallet2 text-warning"></i> Accommodation & Stays:</label>
          <select id="wizardBudget" class="form-select">
            <option value="Budget" selected>Ashram, Sarai & Dharamshala (Peaceful & Budget)</option>
            <option value="Standard">Standard Trust Guesthouses & Hotels</option>
            <option value="Premium">Premium Hotels with VIP Assistance</option>
          </select>
        </div>

        <!-- Travel Pace -->
        <div class="form-group">
          <label><i class="bi bi-speedometer2 text-warning"></i> Travel Rhythm:</label>
          <select id="wizardPace" class="form-select">
            <option value="Peaceful & Meditative" selected>Peaceful & Meditative (Low rush)</option>
            <option value="Moderate">Moderate (Balancing Shrines & Heritage)</option>
            <option value="Express">Express (Cover Maximum Sacred Sites)</option>
          </select>
        </div>

        <!-- Special Considerations -->
        <div class="form-group" style="grid-column: span 2;">
          <label><i class="bi bi-heart-pulse-fill text-warning"></i> Pilgrim Accessibility & Support:</label>
          <select id="wizardNeeds" class="form-select">
            <option value="None" selected>General Devotees (Standard mobility)</option>
            <option value="Senior Citizens">Senior Citizens (Needs battery carts, lift, minimal walking)</option>
            <option value="Wheelchair Accessibility">Wheelchair Accessibility & Divyangjan facilities</option>
            <option value="Family with Young Children">Family with Young Children</option>
          </select>
        </div>

      </div>

      <button type="submit" id="wizardSubmitBtn" class="generate-btn">
        <i class="bi bi-magic"></i> Generate Sacred Itinerary with AI
      </button>
    </form>

    <!-- Itinerary Result -->
    <div id="itineraryOutput" class="itinerary-output">
      <div class="itinerary-header-bar">
        <div class="itinerary-title-meta">
          <h3 id="itineraryResultHeading">🕊️ Your Sacred Pilgrimage Plan</h3>
          <small style="color: #64748b;">Generated with devotion and official shrine timings</small>
        </div>
        <div class="itinerary-actions">
          <button id="voiceNarrateBtn" class="tool-btn btn-voice" onclick="toggleSpeechNarration()">
            <i class="bi bi-volume-up-fill"></i> <span id="voiceBtnText">Listen</span>
          </button>
          <button class="tool-btn" onclick="copyItineraryText()">
            <i class="bi bi-clipboard-check"></i> Copy
          </button>
          <button class="tool-btn" onclick="printItinerary()">
            <i class="bi bi-printer-fill"></i> Print / PDF
          </button>
          <button class="tool-btn" onclick="shareWhatsApp()">
            <i class="bi bi-whatsapp"></i> WhatsApp
          </button>
        </div>
      </div>

      <div id="itineraryRendered" class="itinerary-content"></div>
    </div>
  </div>

  <!-- Mode 2: Chat Pane -->
  <div id="chatPane" class="planner-card chat-pane">
    <div style="margin-bottom: 20px;">
      <h3 style="font-size: 1.35rem; color: #92400e; font-weight: 700; margin-bottom: 6px;">
        💬 Ask Divya Yatra AI Anything
      </h3>
      <p style="color: #64748b; font-size: 0.95rem; margin: 0;">
        Ask specific questions about any temple, gurdwara, dargah, monastery, or basilica in India.
      </p>
    </div>

    <!-- Multi-Faith Quick Prompts -->
    <div style="margin-bottom: 20px; display: flex; flex-wrap: wrap; gap: 8px;">
      <button class="chip-btn" onclick="sendChatPrompt('What are the rules, head covering, and free langar timings at Golden Temple Amritsar?')">
        ☬ Golden Temple Langar
      </button>
      <button class="chip-btn" onclick="sendChatPrompt('What is the respectful etiquette and best time for Ziyarat at Ajmer Sharif Dargah?')">
        ☪️ Ajmer Sharif Ziyarat
      </button>
      <button class="chip-btn" onclick="sendChatPrompt('Guide me on meditation timings and rules under the sacred Bodhi Tree in Bodh Gaya')">
        ☸️ Bodh Gaya Meditation
      </button>
      <button class="chip-btn" onclick="sendChatPrompt('What are the holy masses and feast dates of Basilica of Bom Jesus Goa?')">
        ✝️ Bom Jesus Basilica Goa
      </button>
      <button class="chip-btn" onclick="sendChatPrompt('What are the climbing tips and no-leather rules for Palitana Jain temples?')">
        🌸 Palitana Jain Pilgrimage
      </button>
      <button class="chip-btn" onclick="sendChatPrompt('What is the strict dress code for Tirupati Balaji for men and women?')">
        🛕 Tirupati Balaji Dress Code
      </button>
    </div>

    <!-- Chat Box -->
    <div class="chat-box">
      <div class="chat-header">
        <div style="display: flex; align-items: center; gap: 8px; font-size: 0.9rem; font-weight: 600; color: #166534;">
          <span style="width: 8px; height: 8px; background: #22c55e; border-radius: 50%;"></span>
          Divya Yatra AI is Online (All Traditions Supported)
        </div>
        <button class="tool-btn" onclick="clearConversation()">
          <i class="bi bi-trash3"></i> Clear Chat
        </button>
      </div>

      <div class="chat-messages" id="chatStream">
        <div class="message bot-message">
          <div class="message-avatar">🕊️</div>
          <div class="message-bubble">
            <h4 style="margin: 0 0 6px 0; color: #92400e;">🙏 Welcome to Universal Spiritual Guidance!</h4>
            I am <b>Divya Yatra AI</b>. I provide respectful, expert guidance across all sacred traditions of India: temples, gurdwaras, dargahs, stupas, Jain tirthas, and cathedrals. Ask me any question!
          </div>
        </div>
      </div>

      <div class="chat-input-bar">
        <form id="freeChatForm" onsubmit="handleFreeChatSubmit(event)">
          <div class="chat-input-wrapper">
            <input
              type="text"
              id="freeChatInput"
              class="chat-input"
              placeholder="Ask anything (e.g. Golden Temple timings, Ajmer Sharif chadar, Bodh Gaya meditation...)"
              autocomplete="off"
              required
            />
            <button type="button" class="chat-mic-btn" id="chatMicBtn" title="Speak your question">
              <i class="bi bi-mic-fill"></i>
            </button>
            <button type="submit" id="freeChatSendBtn" class="send-btn" aria-label="Send message">
              <i class="bi bi-send-fill"></i>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

</div>

<!-- Logic Scripts -->
<script>
  let currentRawItineraryText = "";
  let isSpeaking = false;
  let synth = window.speechSynthesis;
  let audioContext = null;
  let isAudioPlaying = false;

  const chatStream = document.getElementById("chatStream");
  const freeChatInput = document.getElementById("freeChatInput");
  const freeChatSendBtn = document.getElementById("freeChatSendBtn");
  const chatMicBtn = document.getElementById("chatMicBtn");
  const chatHistory = [];

  const initialPromptFromQuery = <%- JSON.stringify(initialPrompt || "") %>;
  window.addEventListener("DOMContentLoaded", () => {
    if (initialPromptFromQuery && initialPromptFromQuery.trim()) {
      switchMode('chat');
      sendChatPrompt(initialPromptFromQuery);
    }
  });

  function switchMode(mode) {
    const wizardPane = document.getElementById("wizardPane");
    const chatPane = document.getElementById("chatPane");
    const tabWizardBtn = document.getElementById("tabWizardBtn");
    const tabChatBtn = document.getElementById("tabChatBtn");

    if (mode === "wizard") {
      wizardPane.style.display = "block";
      chatPane.style.display = "none";
      tabWizardBtn.classList.add("active");
      tabChatBtn.classList.remove("active");
    } else {
      wizardPane.style.display = "none";
      chatPane.style.display = "block";
      tabWizardBtn.classList.remove("active");
      tabChatBtn.classList.add("active");
      freeChatInput.focus();
    }
  }

  function pickDest(destName) {
    document.getElementById("wizardDest").value = destName;
  }

  function formatMarkdown(text) {
    if (!text) return "";
    let html = text
      .replace(/^### (.*$)/gim, '<h3>$1</h3>')
      .replace(/^## (.*$)/gim, '<h4>$1</h4>')
      .replace(/^# (.*$)/gim, '<h4>$1</h4>')
      .replace(/\*\*(.*?)\*\*/gim, '<b>$1</b>')
      .replace(/\*(.*?)\*/gim, '<i>$1</i>')
      .replace(/---/gim, '<hr style="border-color:#fed7aa; margin:16px 0;">')
      .replace(/^\s*-\s+(.*$)/gim, '<li>$1</li>')
      .replace(/\n\n/g, '<br><br>')
      .replace(/\n/g, '<br>');

    if (html.includes('<li>')) {
      html = html.replace(/(<li>.*?<\/li>)/gis, '<ul>$1</ul>');
      html = html.replace(/<\/ul><br><ul>/g, '');
    }
    return html;
  }

  // Wizard Generator
  async function handleWizardSubmit(e) {
    e.preventDefault();
    const dest = document.getElementById("wizardDest").value.trim();
    const days = document.getElementById("wizardDays").value;
    const travelers = document.getElementById("wizardTravelers").value;
    const budgetType = document.getElementById("wizardBudget").value;
    const pace = document.getElementById("wizardPace").value;
    const specialNeeds = document.getElementById("wizardNeeds").value;

    const btn = document.getElementById("wizardSubmitBtn");
    const outputDiv = document.getElementById("itineraryOutput");
    const renderedDiv = document.getElementById("itineraryRendered");
    const heading = document.getElementById("itineraryResultHeading");

    btn.disabled = true;
    btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Weaving Your Sacred Itinerary...`;

    try {
      const res = await fetch("/api/ai-itinerary", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          destination: dest,
          days: days,
          travelers: travelers,
          budgetType: budgetType,
          pace: pace,
          specialNeeds: specialNeeds
        })
      });

      if (!res.ok) throw new Error("Could not generate itinerary");
      const data = await res.json();
      currentRawItineraryText = data.itinerary || "";

      heading.innerText = `🕊️ ${days}-Day Sacred Pilgrimage to ${dest}`;
      renderedDiv.innerHTML = formatMarkdown(currentRawItineraryText);
      outputDiv.style.display = "block";
      outputDiv.scrollIntoView({ behavior: "smooth" });
    } catch (err) {
      console.error(err);
      alert("An error occurred while communicating with the AI Guide. Please try again.");
    } finally {
      btn.disabled = false;
      btn.innerHTML = `<i class="bi bi-magic"></i> Generate Sacred Itinerary with AI`;
    }
  }

  // Text to Speech
  function toggleSpeechNarration() {
    if (!synth) {
      alert("Text-to-speech is not supported on this browser.");
      return;
    }

    const btn = document.getElementById("voiceNarrateBtn");
    const textLabel = document.getElementById("voiceBtnText");

    if (isSpeaking) {
      synth.cancel();
      isSpeaking = false;
      btn.classList.remove("speaking");
      textLabel.innerText = "Listen";
    } else {
      if (!currentRawItineraryText) return;
      const cleanText = currentRawItineraryText.replace(/[*#\-_]/g, ' ');
      const utterance = new SpeechSynthesisUtterance(cleanText);
      utterance.rate = 0.95;
      utterance.pitch = 1.0;

      utterance.onend = () => {
        isSpeaking = false;
        btn.classList.remove("speaking");
        textLabel.innerText = "Listen";
      };

      synth.speak(utterance);
      isSpeaking = true;
      btn.classList.add("speaking");
      textLabel.innerText = "Stop";
    }
  }

  function copyItineraryText() {
    if (!currentRawItineraryText) return;
    navigator.clipboard.writeText(currentRawItineraryText).then(() => {
      alert("✅ Sacred Itinerary copied to your clipboard!");
    });
  }

  function printItinerary() {
    window.print();
  }

  function shareWhatsApp() {
    if (!currentRawItineraryText) return;
    const text = encodeURIComponent(`🕊️ Sacred Pilgrimage Plan from India Pilgrimage Guide:\n\n${currentRawItineraryText.substring(0, 900)}...\n\nView more at: ${window.location.href}`);
    window.open(`https://api.whatsapp.com/send?text=${text}`, "_blank");
  }

  // Multi-Faith Meditation Audio Synthesizer
  function toggleDivineAmbience() {
    const btn = document.getElementById("audioAmbienceBtn");
    const text = document.getElementById("audioStatusText");
    const droneType = document.getElementById("audioDroneType").value;

    if (isAudioPlaying) {
      if (audioContext) {
        audioContext.close();
        audioContext = null;
      }
      isAudioPlaying = false;
      btn.classList.remove("playing");
      text.innerText = "Play Meditative Ambience";
    } else {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        audioContext = new AudioContext();

        let freqs = [136.1, 204.15, 272.2]; // default Om
        if (droneType === "gurbani") {
          freqs = [146.83, 220.0, 293.66]; // D-natural Sa-Pa
        } else if (droneType === "bowl") {
          freqs = [261.63, 528.0, 792.0]; // 528 Hz healing bowl
        }

        freqs.forEach((freq, idx) => {
          const osc = audioContext.createOscillator();
          const gain = audioContext.createGain();

          osc.type = idx % 2 === 0 ? "sine" : "triangle";
          osc.frequency.setValueAtTime(freq, audioContext.currentTime);
          gain.gain.setValueAtTime(0.04 / (idx + 1), audioContext.currentTime);

          osc.connect(gain);
          gain.connect(audioContext.destination);
          osc.start();
        });

        isAudioPlaying = true;
        btn.classList.add("playing");
        text.innerText = "Pause Ambience 🎶";
      } catch (e) {
        console.warn("Audio synthesis error:", e);
      }
    }
  }

  // Free Chat handlers
  function appendChatMessage(role, text) {
    const isUser = role === "user";
    const msg = document.createElement("div");
    msg.className = `message ${isUser ? "user-message" : "bot-message"}`;

    const avatar = document.createElement("div");
    avatar.className = "message-avatar";
    avatar.innerHTML = isUser ? '<i class="bi bi-person-fill"></i>' : '🕊️';

    const bubble = document.createElement("div");
    bubble.className = "message-bubble";
    if (isUser) {
      bubble.textContent = text;
    } else {
      bubble.innerHTML = formatMarkdown(text);
    }

    msg.appendChild(avatar);
    msg.appendChild(bubble);
    chatStream.appendChild(msg);
    chatStream.scrollTop = chatStream.scrollHeight;
  }

  async function sendChatPrompt(text) {
    if (!text || !text.trim()) return;

    appendChatMessage("user", text);
    chatHistory.push({ role: "user", content: text });
    freeChatInput.value = "";
    freeChatSendBtn.disabled = true;

    const tempLoader = document.createElement("div");
    tempLoader.id = "chatStreamLoader";
    tempLoader.className = "message bot-message";
    tempLoader.innerHTML = `<div class="message-avatar">🕊️</div><div class="message-bubble"><i>Consulting sacred archives across all traditions...</i></div>`;
    chatStream.appendChild(tempLoader);
    chatStream.scrollTop = chatStream.scrollHeight;

    try {
      const res = await fetch("/api/ai-chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ message: text, history: chatHistory })
      });

      const loader = document.getElementById("chatStreamLoader");
      if (loader) loader.remove();

      if (!res.ok) throw new Error("Network response failed");
      const data = await res.json();
      const reply = data.reply || "Could not generate reply.";
      appendChatMessage("assistant", reply);
      chatHistory.push({ role: "assistant", content: reply });
    } catch (e) {
      const loader = document.getElementById("chatStreamLoader");
      if (loader) loader.remove();
      appendChatMessage("assistant", "⚠️ Connection error. Please verify your connection.");
    } finally {
      freeChatSendBtn.disabled = false;
    }
  }

  function handleFreeChatSubmit(e) {
    e.preventDefault();
    const val = freeChatInput.value.trim();
    if (val) sendChatPrompt(val);
  }

  function clearConversation() {
    chatStream.innerHTML = `
      <div class="message bot-message">
        <div class="message-avatar">🕊️</div>
        <div class="message-bubble">
          <h4 style="margin:0 0 6px 0; color:#92400e;">🙏 Peace & Blessings!</h4>
          Conversation cleared. Ask any new pilgrimage question across any spiritual faith!
        </div>
      </div>
    `;
    chatHistory.length = 0;
  }

  // Voice Recognition for Chat Input
  if (chatMicBtn && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const recognition = new SpeechRecognition();
    recognition.lang = 'en-IN';
    recognition.continuous = false;
    recognition.interimResults = false;

    chatMicBtn.addEventListener("click", () => {
      chatMicBtn.classList.add("listening");
      recognition.start();
    });

    recognition.onresult = (event) => {
      const transcript = event.results[0][0].transcript;
      freeChatInput.value = transcript;
      chatMicBtn.classList.remove("listening");
      sendChatPrompt(transcript);
    };

    recognition.onerror = () => { chatMicBtn.classList.remove("listening"); };
    recognition.onend = () => { chatMicBtn.classList.remove("listening"); };
  } else if (chatMicBtn) {
    chatMicBtn.style.display = "none";
  }
</script>
