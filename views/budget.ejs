<% layout("layouts/boilerplate.ejs") %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
  .budget-container {
    max-width: 980px;
    margin: 40px auto 80px auto;
    padding: 0 15px;
    padding-top: 60px;
  }

  .budget-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .budget-header h1 {
    font-size: 2.3rem;
    font-weight: 800;
    color: #78350f;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .budget-header p {
    color: #64748b;
    font-size: 1.05rem;
  }

  .budget-card {
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.05);
    padding: 35px;
  }

  .budget-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    margin-bottom: 25px;
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.92rem;
    color: #1e293b;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .form-control, .form-select {
    border-radius: 14px;
    border: 1.5px solid #cbd5e1;
    padding: 11px 16px;
    font-size: 0.96rem;
    transition: all 0.2s;
  }

  .form-control:focus, .form-select:focus {
    border-color: #f59e0b;
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
  }

  .calc-btn {
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #ffffff;
    border: none;
    border-radius: 30px;
    padding: 14px 30px;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 8px 24px rgba(217, 119, 6, 0.3);
    transition: all 0.25s ease;
  }

  .calc-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(217, 119, 6, 0.4);
    background: linear-gradient(135deg, #fbbf24 0%, #b45309 100%);
  }

  /* Result Box */
  .budget-result-card {
    display: none;
    margin-top: 35px;
    background: linear-gradient(135deg, #fffbeb, #fef3c7);
    border: 1.5px solid #fde68a;
    border-radius: 20px;
    padding: 28px;
    animation: fadeIn 0.3s ease;
  }

  .result-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    margin-bottom: 20px;
    padding-bottom: 18px;
    border-bottom: 1px solid #fde68a;
  }

  .total-budget-badge h3 {
    margin: 0;
    font-size: 2rem;
    font-weight: 800;
    color: #92400e;
  }

  .cost-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 15px;
    margin-bottom: 22px;
  }

  .cost-mini-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 16px;
    border: 1px solid #fcd34d;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  }

  .cost-mini-card small {
    display: block;
    color: #64748b;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .cost-mini-card span {
    font-size: 1.35rem;
    font-weight: 800;
    color: #1e293b;
  }

  .budget-progress-bar {
    height: 12px;
    border-radius: 10px;
    overflow: hidden;
    display: flex;
    margin-bottom: 20px;
  }

  .bar-travel { background: #3b82f6; }
  .bar-stay { background: #10b981; }
  .bar-food { background: #f59e0b; }

  .bar-legend {
    display: flex;
    gap: 18px;
    font-size: 0.84rem;
    color: #475569;
    font-weight: 600;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .btn-ai-budget {
    background: linear-gradient(135deg, #1e293b, #0f172a);
    color: #ffd166;
    border: 1px solid rgba(255, 209, 102, 0.4);
    border-radius: 30px;
    padding: 12px 24px;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
  }
  .btn-ai-budget:hover {
    background: #000;
    color: #fff;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .budget-card { padding: 20px; }
    .budget-header h1 { font-size: 1.8rem; }
  }
</style>

<div class="container budget-container">

  <div class="budget-header">
    <h1>🧮 Pilgrimage Cost & Budget Planner</h1>
    <p>Estimate transparent travel, accommodation, and satvik meal expenses for your holy journey.</p>
  </div>

  <div class="budget-card">
    <form id="budgetCalculatorForm">
      
      <!-- Filter Destination -->
      <div style="margin-bottom: 20px;">
        <label style="font-weight: 600; color: #1e293b; margin-bottom: 6px; display: block;">
          <i class="bi bi-geo-alt-fill text-warning"></i> Select Pilgrimage Destination:
        </label>
        <input
          type="text"
          id="placeFilterInput"
          placeholder="Type to filter destinations (e.g. Varanasi, Kedarnath, Tirupati)..."
          class="form-control mb-2"
        />
        <select id="placeSelect" class="form-select" required>
          <% listings.forEach(place => { %>
            <option value="<%= place.distance %>" data-title="<%= place.title %>">
              <%= place.title %> (~<%= place.distance %> km)
            </option>
          <% }) %>
        </select>
      </div>

      <div class="budget-grid">
        <!-- Days -->
        <div class="form-group">
          <label><i class="bi bi-calendar-event text-warning"></i> Total Days:</label>
          <input type="number" id="inputDays" class="form-control" min="1" max="30" value="3" required>
        </div>

        <!-- Devotees -->
        <div class="form-group">
          <label><i class="bi bi-people text-warning"></i> Devotees / Travelers:</label>
          <input type="number" id="inputTravelers" class="form-control" min="1" max="50" value="2" required>
        </div>

        <!-- Travel Mode -->
        <div class="form-group">
          <label><i class="bi bi-train-front text-warning"></i> Travel Mode:</label>
          <select id="selectTravelMode" class="form-select">
            <option value="Train" selected>Train (Express / Superfast Sleeper & 3AC)</option>
            <option value="Bus">State Road Transport / AC Volvo Bus</option>
            <option value="Car">Private Car / SUV Rental</option>
            <option value="Flight">Flight + Local Cab Transfer</option>
          </select>
        </div>

        <!-- Stay Type -->
        <div class="form-group">
          <label><i class="bi bi-building text-warning"></i> Stay Type:</label>
          <select id="selectStayType" class="form-select">
            <option value="Budget" selected>Ashram / Trust Dharamshala (₹800/room)</option>
            <option value="Standard">Standard Hotel / Guest House (₹1,500/room)</option>
            <option value="Luxury">Premium Hotel with Amenities (₹3,200/room)</option>
          </select>
        </div>

        <!-- Food Type -->
        <div class="form-group">
          <label><i class="bi bi-cup-hot text-warning"></i> Food & Bhojan Type:</label>
          <select id="selectFoodType" class="form-select">
            <option value="Economy" selected>Economy & Temple Prasadam / Langar (₹250/day/person)</option>
            <option value="Standard">Pure Vegetarian / Sattvic Restaurants (₹450/day/person)</option>
            <option value="Premium">Premium Multi-Cuisine Dining (₹750/day/person)</option>
          </select>
        </div>
      </div>

      <button type="submit" class="calc-btn">
        <i class="bi bi-calculator"></i> Calculate Detailed Budget
      </button>
    </form>

    <!-- Calculation Result -->
    <div id="budgetResultCard" class="budget-result-card">
      <div class="result-top-row">
        <div>
          <small style="color: #64748b; font-weight: 700; text-transform: uppercase;">Estimated Total Expense</small>
          <div class="total-budget-badge">
            <h3 id="displayTotal">₹0</h3>
          </div>
          <small id="perPersonText" style="color: #92400e; font-weight: 600;"></small>
        </div>

        <div>
          <a id="aiOptimizeBtn" href="#" class="btn-ai-budget">
            <i class="bi bi-stars"></i> Ask AI How to Optimize Budget
          </a>
        </div>
      </div>

      <!-- Cost Breakdown Cards -->
      <div class="cost-cards-grid">
        <div class="cost-mini-card">
          <small>🚆 Travel Cost</small>
          <span id="displayTravel">₹0</span>
        </div>
        <div class="cost-mini-card">
          <small>🏨 Stay & Boarding</small>
          <span id="displayStay">₹0</span>
        </div>
        <div class="cost-mini-card">
          <small>🍲 Satvik Food & Meals</small>
          <span id="displayFood">₹0</span>
        </div>
      </div>

      <!-- Ratio Bar -->
      <div class="budget-progress-bar">
        <div id="barTravel" class="bar-travel" style="width: 33%;"></div>
        <div id="barStay" class="bar-stay" style="width: 33%;"></div>
        <div id="barFood" class="bar-food" style="width: 34%;"></div>
      </div>

      <div class="bar-legend">
        <span><span class="legend-dot bar-travel"></span> Travel</span>
        <span><span class="legend-dot bar-stay"></span> Stay</span>
        <span><span class="legend-dot bar-food"></span> Food</span>
      </div>

      <div style="font-size: 0.85rem; color: #78350f; background: rgba(255,255,255,0.6); padding: 10px 14px; border-radius: 10px;">
        💡 <b>Pilgrim Savings Tip:</b> Booking government shrine board guesthouses (TTD, GMVN, Kashi Trust) and participating in free community Langars & Annadanams can reduce food and stay expenses by up to 60%!
      </div>
    </div>
  </div>

</div>

<script>
  const placeSearch = document.getElementById("placeFilterInput");
  const placeSelect = document.getElementById("placeSelect");
  const budgetForm = document.getElementById("budgetCalculatorForm");
  const resultCard = document.getElementById("budgetResultCard");

  // Filter dropdown
  placeSearch.addEventListener("input", function() {
    const f = placeSearch.value.toLowerCase();
    Array.from(placeSelect.options).forEach(opt => {
      opt.style.display = opt.text.toLowerCase().includes(f) ? "" : "none";
    });
  });

  // Auto-select from URL params
  const urlParams = new URLSearchParams(window.location.search);
  const targetPlace = urlParams.get("place");
  if (targetPlace) {
    const matchingOpt = Array.from(placeSelect.options).find(opt => 
      opt.getAttribute("data-title") && opt.getAttribute("data-title").toLowerCase().includes(targetPlace.toLowerCase())
    );
    if (matchingOpt) {
      matchingOpt.selected = true;
    }
  }

  // Calculate
  budgetForm.addEventListener("submit", function(e) {
    e.preventDefault();

    const distance = Number(placeSelect.value) || 500;
    const selectedOption = placeSelect.options[placeSelect.selectedIndex];
    const placeTitle = selectedOption ? selectedOption.getAttribute("data-title") : "the destination";

    const days = Math.max(1, Number(document.getElementById("inputDays").value));
    const travelers = Math.max(1, Number(document.getElementById("inputTravelers").value));
    const travelMode = document.getElementById("selectTravelMode").value;
    const stayType = document.getElementById("selectStayType").value;
    const foodType = document.getElementById("selectFoodType").value;

    // Travel Computation
    let travelCost = 0;
    if (travelMode === "Train") travelCost = distance * 1.6 * travelers;
    else if (travelMode === "Bus") travelCost = distance * 2.2 * travelers;
    else if (travelMode === "Car") travelCost = (distance * 2 / 14) * 105; // roundtrip fuel
    else if (travelMode === "Flight") travelCost = (3500 + (distance * 4.5)) * travelers;

    travelCost = Math.round(travelCost);

    // Stay Computation (Assuming 2 persons per room)
    const rooms = Math.ceil(travelers / 2);
    const roomRate = stayType === "Budget" ? 800 : (stayType === "Standard" ? 1500 : 3200);
    const stayCost = Math.round(roomRate * rooms * days);

    // Food Computation
    const mealDailyRate = foodType === "Economy" ? 250 : (foodType === "Standard" ? 450 : 750);
    const foodCost = Math.round(mealDailyRate * days * travelers);

    const total = travelCost + stayCost + foodCost;
    const perPerson = Math.round(total / travelers);

    // Update displays
    document.getElementById("displayTotal").innerText = `₹${total.toLocaleString('en-IN')}`;
    document.getElementById("displayTravel").innerText = `₹${travelCost.toLocaleString('en-IN')}`;
    document.getElementById("displayStay").innerText = `₹${stayCost.toLocaleString('en-IN')}`;
    document.getElementById("displayFood").innerText = `₹${foodCost.toLocaleString('en-IN')}`;
    document.getElementById("perPersonText").innerText = `(~₹${perPerson.toLocaleString('en-IN')} per devotee)`;

    // Update ratio bar
    const pTravel = Math.round((travelCost / total) * 100);
    const pStay = Math.round((stayCost / total) * 100);
    const pFood = 100 - (pTravel + pStay);

    document.getElementById("barTravel").style.width = pTravel + "%";
    document.getElementById("barStay").style.width = pStay + "%";
    document.getElementById("barFood").style.width = pFood + "%";

    // Link AI Optimize
    const aiPrompt = `I am planning a ${days}-day pilgrimage to ${placeTitle} for ${travelers} devotees with an estimated budget of ₹${total}. How can I optimize costs for stays, transport, and satvik meals while having a deeply fulfilling spiritual experience?`;
    document.getElementById("aiOptimizeBtn").href = `/ai-guide?prompt=${encodeURIComponent(aiPrompt)}`;

    resultCard.style.display = "block";
    resultCard.scrollIntoView({ behavior: "smooth" });
  });
</script>
