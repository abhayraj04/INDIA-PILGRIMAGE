<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>visit</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    

</head>
<body>
     
<!-- GLOBAL ONE-SIDE ANIMATION SYSTEM -->
<div class="side-strip">

  <div class="glow-wave"></div>

  <div class="dots">
    <span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span>
  </div>

  <div class="scroll-line"></div>

  <!-- Toggle button -->
  <div class="side-toggle">⦿</div>

</div>

    <%- include("../includes/navbar.ejs") %>
    <div class="container">
        <%- body %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<style>
/* =====================================
   ONE-SIDE FULL ANIMATION (ALL SAFE)
   ===================================== */

.side-strip {
  position: fixed;
  top: 0;
  right: 0; /* change to left:0 if needed */
  width: 60px;
  height: 100vh;
  z-index: 999;
  pointer-events: auto;
  transition: opacity .4s ease;
}

/* Hide on small screens */
@media(max-width:768px){
  .side-strip { display: none; }
}

/* Glow wave */
.glow-wave {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(255,255,255,0),
    rgba(255,220,160,0.3),
    rgba(255,255,255,0)
  );
  animation: wave 6s ease-in-out infinite;
}
@keyframes wave {
  0%,100%{opacity:.3;}
  50%{opacity:.9;}
}

/* Floating dots */
.dots span {
  position: absolute;
  left: 50%;
  width: 6px;
  height: 6px;
  background: rgba(255,200,120,.8);
  border-radius: 50%;
  transform: translateX(-50%);
  animation: float 10s linear infinite;
}
.dots span:nth-child(n){
  top: calc(100% * var(--i));
}
@keyframes float {
  0%{transform:translate(-50%,0);opacity:0;}
  40%{opacity:1;}
  100%{transform:translate(-50%,-300px);opacity:0;}
}

/* Scroll line */
.scroll-line {
  position: absolute;
  right: 10px;
  top: 0;
  width: 4px;
  height: 0%;
  background: linear-gradient(to bottom,#ffd08a,#ffb347);
  border-radius: 10px;
}

/* Toggle button */
.side-toggle {
  position: absolute;
  bottom: 20px;
  right: 15px;
  width: 30px;
  height: 30px;
  background: #ffddb0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 14px;
}

/* OFF state */
.side-strip.off {
  opacity: .15;
}
</style>
<script>
const strip = document.querySelector(".side-strip");
const line = document.querySelector(".scroll-line");
const toggle = document.querySelector(".side-toggle");

/* Scroll progress */
window.addEventListener("scroll", ()=>{
  const scrollTop = window.scrollY;
  const docHeight = document.documentElement.scrollHeight - window.innerHeight;
  const percent = (scrollTop / docHeight) * 100;
  line.style.height = percent + "%";
});

/* Hover reaction */
strip.addEventListener("mouseenter",()=>{
  strip.style.width = "80px";
});
strip.addEventListener("mouseleave",()=>{
  strip.style.width = "60px";
});

/* Toggle ON/OFF */
toggle.addEventListener("click",()=>{
  strip.classList.toggle("off");
});
</script>

</body>
</html>